# Build-time configuration for the app.
#
# EVERY VITE_* VALUE IS BAKED INTO THE PUBLIC BUNDLE. The build ships source
# maps, so treat anything here as published the moment you deploy. Nothing
# secret belongs in this file — the app holds no keys by design.

# nile (default) or mainnet. Deliberately build-time: an account address
# commits to its factory, so an address derived on one network can never have
# code on the other. Build testnet and mainnet separately.
VITE_TPM_NETWORK=nile

# Default relayer. Leave empty and the UI asks the visitor for one, which is
# honest: relaying is permissionless and anyone can run their own.
VITE_TPM_RELAYER=

# Override the factory address. Defaults to the known deployment for the
# network above.
VITE_TPM_FACTORY=

# Optional: a sponsorship policy that pays the relayer fee, and the key that
# proves which project owns it. With both set, transfers cost the user nothing.
VITE_TPM_SPONSORSHIP_POLICY=
VITE_TPM_API_KEY=

# Turnkey passkey wallet. Both values are public: they name an organization
# and its hosted auth proxy, and neither authorizes anything by itself. Create
# them at app.turnkey.com (Auth -> Auth Proxy, with passkey enabled).
# Leave unset and the Turnkey option does not appear at all.
VITE_TURNKEY_ORG_ID=
VITE_TURNKEY_AUTH_PROXY_ID=

# "eip712" (default) sends Turnkey the typed data, so its policy engine can
# pin the permit's token, recipient and relayer. "digest" sends 32 opaque
# bytes instead — use only if Turnkey's EIP-712 encoding ever disagrees with
# the contract's.
VITE_TURNKEY_SIGN_MODE=
