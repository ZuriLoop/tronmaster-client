{
  "name": "@tron-paymaster/react",
  "version": "0.1.0",
  "description": "React hooks for gasless Tron USDT: connect a wallet, derive a gasless account, send without TRX.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tron-paymaster/sdk": "^0.1.0",
    "react": ">=18",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@tron-paymaster/sdk": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "viem": "2.57.16",
    "vitest": "4.1.12"
  },
  "repository": { "type": "git", "url": "git+https://github.com/ZuriLoop/tronmaster-client.git", "directory": "react" }
}
