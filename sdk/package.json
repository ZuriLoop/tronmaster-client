{
  "name": "@tron-paymaster/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for TronPaymaster: Tron gas sponsorship with deposit forwarders and TIP-712 permit accounts.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "vectors"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vectors": "tsup && node scripts/gen-vectors.mjs"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "viem": "2.57.16",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZuriLoop/tronmaster-client.git",
    "directory": "sdk"
  }
}
